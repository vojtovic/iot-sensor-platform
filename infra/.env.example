# Příklad konfigurace pro infra/docker-compose.yml.
# Zkopíruj na .env a uprav pro lokální běh: cp .env.example .env
#
# .env je v .gitignore — necommituje se.

# ──────────────────────────────────────────────────────────────
#  EMQX dashboard  (http://localhost:18083)
# ──────────────────────────────────────────────────────────────
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=iot-dev

# ──────────────────────────────────────────────────────────────
#  TimescaleDB  (postgres://USER:PASSWORD@localhost:5432/DB)
# ──────────────────────────────────────────────────────────────
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot-dev
POSTGRES_DB=iot

# ──────────────────────────────────────────────────────────────
#  Grafana  (http://localhost:3000)
# ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=iot-dev
